{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                ci.id,\n                c.id as cart_id,\n                c.user_id,\n                ci.product_id,\n                ci.quantity,\n                ci.id as cart_item_id,\n                p.name as product_name,\n                p.price as product_price\n            FROM carts c\n            JOIN cart_items ci\n                ON ci.cart_id = c.id\n            LEFT JOIN products p\n                ON p.id = ci.product_id\n            WHERE c.id = $1\n            ",
