  "query": "\n            UPDATE orders\n            SET total_price = COALESCE($1, total_price),\n                status = COALESCE($2, status)\n            WHERE id = $3\n            RETURNING id, user_id, total_price, status as \"status: OrderStatus\", created_at\n            ",
